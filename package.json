{
  "name": "codex-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Codex harness (DeepSeek) 图形化驾驶舱 — 用鼠标完整操作编程 agent",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node test/bridge-translate.mjs && node test/bridge-e2e.mjs && node test/orchestrator-e2e.mjs && node test/appserver-e2e.mjs && node test/continuity-e2e.mjs && node test/appearance-unit.mjs && node test/attachments-unit.mjs && node test/workspace-files-unit.mjs && node test/context-menu-unit.mjs",
    "test:unit": "node test/bridge-translate.mjs",
    "test:bridge": "node test/bridge-e2e.mjs",
    "test:pipeline": "node test/orchestrator-e2e.mjs",
    "test:approval": "node test/appserver-e2e.mjs",
    "test:continuity": "node test/continuity-e2e.mjs",
    "test:appearance": "node test/appearance-unit.mjs",
    "test:attachments": "node test/attachments-unit.mjs",
    "test:filetree": "node test/workspace-files-unit.mjs",
    "test:contextmenu": "node test/context-menu-unit.mjs",
    "verify:app": "node scripts/verify-app.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "verify:appearance": "node scripts/verify-appearance.mjs",
    "verify:background": "node scripts/verify-background.mjs",
    "verify:slots": "node scripts/verify-slots.mjs",
    "verify:conversation": "node scripts/verify-conversation.mjs",
    "verify:approval-ui": "node scripts/verify-approval-ui.mjs",
    "verify:context-ui": "node scripts/verify-context-ui.mjs",
    "verify:attach-ui": "node scripts/verify-attach-ui.mjs",
    "verify:contextmenu-ui": "node scripts/verify-contextmenu-ui.mjs",
    "pack:portable": "node scripts/pack-portable.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "diagnose:appserver": "node scripts/diagnose-appserver.mjs",
    "install:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File launch/install.ps1",
    "uninstall:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File launch/uninstall.ps1",
    "dist": "electron-vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@openai/codex": "^0.154.0"
  }
}
